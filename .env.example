# ========== Local machine (WebStorm / localhost) and Render/mobile: same database ==========
# Key point: whether desktop and mobile share data depends on using the exact same MONGO_URL.
# - Do not use mongodb://127.0.0.1 for both local and Render at the same time.
#   In cloud runtime, 127.0.0.1 points to a different machine.
# - MongoDB Atlas is recommended. Put the exact same values in local .env and
#   Render Dashboard -> Environment:
#     MONGO_URL  (Atlas connection string)
#     DB_NAME    (for example: companydb)
# npm start runs start-smartspend.cjs checks first:
# on Render, startup is blocked if MONGO_URL still points to localhost.
#
# Atlas connection string example (replace USER, PASSWORD, and cluster):
# MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=cluster0
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=cluster0
DB_NAME=companydb

# Local development
APP_BASE_URL=http://localhost:3001
# When deploying to Render, set APP_BASE_URL in Render env vars to your public URL, for example:
# APP_BASE_URL=https://smartspend-ccwe.onrender.com

# ========== First-time setup or reset: after MONGO_URL points to Atlas, run npm run seed:demo ==========
# The account below is written to the shared DB. Use the same credentials on local and
# https://smartspend-ccwe.onrender.com to sign in.
DEMO_USER_EMAIL=demo@smartspend.local
DEMO_USER_PASSWORD=ChangeThisDemo123
DEMO_USER_NAME=SmartSpend Demo
# Quick demo login (after running `npm run seed:demo`):
# Email: demo@smartspend.local
# Password: ChangeThisDemo123
# The seed script writes passwordSalt/passwordHash using scrypt
# so the generated demo account can sign in immediately.

# ========== Other settings (keep as before; local and cloud can differ from Mongo values) ==========
PORT=3001
HF_TOKEN=replace_with_your_hugging_face_token
HF_API_URL=https://router.huggingface.co/v1/chat/completions
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct:fastest
HF_FALLBACK_MODELS=deepseek-ai/DeepSeek-V3-0324:fastest,deepseek-ai/DeepSeek-R1:fastest
HF_MAX_TOKENS=500
BUDGET_ALERT_THRESHOLD=0.8
PASSWORD_RESET_MAX_ATTEMPTS=5
EXPENSE_SEARCH_MAX_LENGTH=80
# Leave false in normal app startup. Set true only for a one-off legacy cleanup of demo@smartspend.com data.
REMOVE_DEMO_ARTIFACTS=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=SmartSpend <your_email@gmail.com>
LEGACY_DATA_OWNER_EMAIL=your_demo_email@gmail.com
